# Основные сведения о проекте
PROJECT_NAME           = "StAlGoLM"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Клиент-серверная система учебных заданий на C++ и Qt"
OUTPUT_DIRECTORY       = documentation/doxygen
OUTPUT_LANGUAGE        = Russian

# Исходные файлы
INPUT                  = README.md \
                         main.cpp \
                         mytcpserver.h mytcpserver.cpp \
                         server_functions.h server_functions.cpp \
                         databasemanager.h databasemanager.cpp \
                         task1.h task1.cpp \
                         task2.h task2.cpp \
                         task3.h task3.cpp \
                         task4.h task4.cpp \
                         client/mainwindow.h client/mainwindow.cpp
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md
INPUT_ENCODING         = UTF-8

# Извлечение документации
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Имена и исходный код
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# HTML
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

# Другие форматы в рамках задания не требуются
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

# Диаграммы
HAVE_DOT               = YES
DOT_PATH               = "C:/Program Files/Graphviz/bin"
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 20
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 0
GENERATE_LEGEND        = YES

# Диагностика
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = documentation/doxygen-warnings.log
